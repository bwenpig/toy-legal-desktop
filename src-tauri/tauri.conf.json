{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 864,
        "minHeight": 640,
        "minWidth": 1024,
        "title": "Toys Gallery 會計系統",
        "width": 1366
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Toys Gallery International Limited 會計系統桌面版：Voucher 入賬、總賬、9 份報表、財年管理。",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "shortDescription": "Toys Gallery 會計系統",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null
    }
  },
  "identifier": "com.toysgallery.accounting",
  "plugins": {
    "sql": {
      "preload": []
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://update.example.com/latest.json"
      ],
      "pubkey": "PLACEHOLDER_UPDATER_PUBLIC_KEY_REPLACE_BEFORE_RELEASE"
    },
    "fs": {}
  },
  "productName": "Toys Gallery 會計系統",
  "version": "3.21.5"
}